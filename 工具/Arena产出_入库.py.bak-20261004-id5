# -*- coding: utf-8 -*-
"""把 Arena 抽取产出验证并入库（批004 第1354-1355课）。"""
import json
import pathlib
import re

BASE = pathlib.Path(r'C:\Users\赵豪\dsh')
OUT = BASE / '交易知识体系汇编'
import sys
UP = pathlib.Path(sys.argv[1])
parsed = json.load(open(sys.argv[2], encoding='utf-8'))
KEEP = re.compile(r'[\u4e00-\u9fffA-Za-z0-9]')


def strip_map(s):
    o, i = [], []
    for idx, ch in enumerate(s):
        if KEEP.match(ch):
            o.append(ch); i.append(idx)
    return ''.join(o), i


SRC = {}
for f in UP.glob('*.md'):
    raw = f.read_text(encoding='utf-8')
    SRC[f.name.split('_')[0]] = (raw, strip_map(raw))


def verify(sid, text):
    if sid not in SRC:
        return '', 0
    raw, (flat, imap) = SRC[sid]
    target, _ = strip_map(text)
    best = (0, -1, -1)
    for i in range(len(target)):
        j = i + best[0] + 1
        while j <= len(target):
            p = flat.find(target[i:j])
            if p < 0:
                break
            j += 1
        seg = target[i:j-1]
        if len(seg) > best[0]:
            best = (len(seg), i, flat.find(seg))
    blen, tstart, fstart = best
    if blen < 8:
        return '', 0
    o0, o1 = imap[fstart], imap[fstart + blen - 1]
    return re.sub(r'\s+', '', raw[o0:o1+1]), blen


# 1) 证据验证
rows, okc, bad = [], 0, []
for line in parsed['tsv']:
    cells = line.split('\t')
    cells = [c.strip() for c in cells]
    eid, sid = cells[0], (cells[1] if len(cells) > 1 else '')
    rest = '\t'.join(cells[2:])
    q, n = verify(sid, rest)
    if q:
        okc += 1
        rows.append([eid, sid, '', q, '', '2026-09-28'])
    else:
        bad.append((eid, sid, rest[:70]))
print('证据 %d 条 | 验证通过 %d | 未通过 %d' % (len(parsed['tsv']), okc, len(bad)))
for b in bad:
    print('   未通过:', b[0], b[1], b[2])

# 2) 写卡片
ncard = 0
for cid, name, body in parsed['cards']:
    d = {'K': '02_知识点', 'S': '03_方法与策略', 'C': '04_案例'}[cid[0]]
    safe = re.sub(r'[\\/:*?"<>|]', '', name)[:40]
    p = OUT / d / ('%s_%s.md' % (cid, safe))
    if p.exists():
        print('   已存在，跳过:', p.name)
        continue
    p.write_text('# %s %s\n%s' % (cid, name, body.rstrip()) + '\n', encoding='utf-8')
    ncard += 1
print('写入卡片:', ncard)

# 3) 证据入索引
evp = OUT / '01_资料与索引/证据索引.tsv'
have = set(re.findall(r'(?m)^(E-\d{4})\t', evp.read_text(encoding='utf-8')))
add = [r for r in rows if r[0] not in have]
with open(evp, 'a', encoding='utf-8') as f:
    for r in add:
        f.write('\t'.join(r) + '\n')
print('证据入索引:', len(add))

# 4) 复验
raw = evp.read_text(encoding='utf-8')
ids = set(re.findall(r'(?m)^(E-\d{4})\t', raw))
cards = {q.stem.split('_')[0] for d in ('02_知识点', '03_方法与策略', '04_案例') for q in (OUT / d).glob('*.md')}
be = bc = nosrc = 0
for d in ('02_知识点', '03_方法与策略', '04_案例'):
    for q in (OUT / d).glob('*.md'):
        t = q.read_text(encoding='utf-8')
        be += sum(1 for e in set(re.findall(r'E-\d{4}', t)) if e not in ids)
        bc += sum(1 for c in set(re.findall(r'\b([KSC]-\d{4})\b', t)) if c not in cards)
        if not re.search(r'^> 来源：SRC-', t, re.M):
            nosrc += 1
print('卡片 %d | 悬空证据 %d | 悬空卡片 %d | 缺来源行 %d | 证据 %d 条' % (len(cards), be, bc, nosrc, len(ids)))
